# Copy to config.yaml (repo root) and customize.
bridge_url: "http://localhost:8899"
health_endpoint: "/healthz"
runtime_snapshot_endpoint: "/runtime_snapshot"
reconnect_endpoint: "/recover/reconnect"
flatten_then_reconnect_endpoint: "/recover/flatten_then_reconnect"
# Preferred NT connection names to target during reconnect attempts.
connection_names:
  - "My NinjaTrader"

poll_interval_sec: 60
startup_grace_sec: 90
mainthread_stuck_sec: 12
unstable_cycles_before_recovery: 3
reconnect_attempt_limit: 10
notification_cooldown_sec: 900
no_connections_recovery_cooldown_sec: 300
restart_cooldown_sec: 120
max_restarts_per_hour: 2

# Recovery policy selected: flatten open positions, then recover.
recovery_only_when_flat: false

# Primary executable path from user-provided fixed path.
nt_executable_path: "C:\\Program Files\\NinjaTrader 8\\bin\\NinjaTrader.exe"
nt_process_name: "NinjaTrader"
# NT login credentials. After restart, a detached PowerShell helper waits for
# the login dialog and types username/password via SendKeys. NT8 has no CLI
# auth flag, so this is the only way to auto-login after an unattended restart.
# Prefer env vars WATCHDOG_NT_USERNAME / WATCHDOG_NT_PASSWORD over the file.
nt_username: ""
nt_password: ""
process_detect_fallback: true

snapshot_path: "watchdog/state/last_good_snapshot.json"
events_log_path: "watchdog/logs/health_events.jsonl"

# Prefer environment variables for secrets.
telegram_enabled: true
telegram_bot_token: ""
telegram_chat_id: ""
telegram_parse_mode: ""
telegram_allowed_user_ids: []

# Whitelisted Telegram users can send plain text or unknown /commands as
# ad hoc Codex questions. Codex runs in read-only sandbox mode with no approval
# escalation, a concise reply cap, and a small FIFO queue.
telegram_adhoc_codex_enabled: true
telegram_adhoc_codex_command: "C:\\Users\\sshrestha\\AppData\\Roaming\\npm\\codex.ps1"
telegram_adhoc_codex_workdir: ""
telegram_adhoc_codex_data_dir: "watchdog/state/codex_adhoc"
telegram_adhoc_codex_timeout_sec: 120
telegram_adhoc_codex_queue_max: 2
telegram_adhoc_codex_max_reply_chars: 3500
